# Copy this file's keys to your Render dashboard environment variables 
# Do NOT fill in real values here — this file can be committed safely 
 
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster.mongodb.net/inkflow 
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx 
JWT_SECRET=generate-with-openssl-rand-hex-32 
PORT=5000 
 
# Comma-separated list of allowed frontend origins 
# e.g. https://inkflow.vercel.app,https://inkflow.com 
FRONTEND_URL=https://your-frontend.vercel.app 
 
# Use a sender on your verified Resend domain 
EMAIL_FROM=InkFlow <noreply@yourdomain.com> 

# Free Groq API key from https://console.groq.com/keys (for AI Polish & Enhance)
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxx
